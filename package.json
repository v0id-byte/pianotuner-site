{
  "name": "pianotuner-site",
  "version": "2.0.0",
  "private": true,
  "description": "pianotuner.top — 钢琴调音机器人官网（Vite + React SSG）",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --outDir ../build-stage --port 4173 --strictPort",
    "preview:root": "vite preview --outDir ../ --port 4174 --strictPort",
    "assets:fonts": "node scripts/subset-fonts.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir ../.ssr-stage",
    "prerender": "node scripts/prerender.mjs",
    "verify:stage": "node scripts/verify-build.mjs build-stage",
    "verify:root": "node scripts/verify-build.mjs .",
    "publish:build": "node scripts/publish-build.mjs",
    "stage": "npm run assets:fonts && npm run build:client && npm run build:ssr && npm run prerender && npm run verify:stage",
    "build": "npm run stage && npm run publish:build",
    "text-diff": "node scripts/text-diff.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:apply": "node scripts/deploy.mjs --apply"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.2"
  }
}
